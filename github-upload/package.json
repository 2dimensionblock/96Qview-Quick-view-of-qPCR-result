{
  "name": "96qview-desktop",
  "version": "1.1.1",
  "description": "Offline qPCR analysis and plotting with a Windows desktop interface",
  "author": "Steven Liu",
  "license": "MIT",
  "private": true,
  "main": "app/main.cjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "electron .",
    "build:frontend": "node scripts/build-frontend.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-project.mjs",
    "dist:win": "node scripts/build-windows.cjs",
    "smoke:windows": "node scripts/run-electron-smoke.cjs",
    "verify:dist": "node scripts/verify-dist.cjs",
    "release:files": "node scripts/release-files.mjs"
  },
  "devDependencies": {
    "electron": "44.5.0",
    "electron-builder": "26.15.3",
    "jsdom": "27.0.0"
  },
  "build": {
    "appId": "com.2dimensionblock.96qview",
    "productName": "96Qview",
    "copyright": "Steven Liu",
    "electronVersion": "44.5.0",
    "asar": true,
    "npmRebuild": false,
    "compression": "normal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.qPCR-Studio.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "96Qview_Windows_x64.exe",
      "requestExecutionLevel": "user"
    }
  }
}
